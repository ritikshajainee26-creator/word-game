{
  "name": "word-guessing-game",
  "version": "1.0.0",
  "description": "Real-time 2-player multiplayer word guessing game with server-authoritative logic, automated matchmaking, and edge-case handling.",
  "main": "src/server/server.js",
  "scripts": {
    "start": "node src/server/server.js",
    "dev": "node --watch src/server/server.js",
    "build": "vite build --outDir client/dist",
    "test": "node --test tests/gameEngine.test.js tests/integration.test.js tests/matchHistoryStore.test.js tests/reconnect.test.js"
  },
  "keywords": [
    "multiplayer",
    "word-guessing",
    "socket.io",
    "real-time",
    "react"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.2.0"
  }
}
